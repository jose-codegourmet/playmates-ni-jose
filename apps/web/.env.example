# Public origin for SSR self-fetch in src/hooks/use-*/server.ts.
# Used when those helpers request /api/blog, /api/pricing, and /api/testimonials.
# Falls back to http://localhost:9000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:9000

# Prisma — required at runtime by src/app/api/{blog,pricing,testimonials}/route.ts
# via @fe-template/db. This app does query Prisma; it does not use Supabase Auth.
# DATABASE_URL: client connection. Prefer the pooled URL (port 6543, ?pgbouncer=true) in production.
# DIRECT_URL: required by packages/db schema.prisma (directUrl), even though this app does not migrate.
# See packages/db/.env.example.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Supabase Auth (unused by this app — no auth or Supabase client)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
