enum Role {
  USER
  ADMIN
}

/// Application row for a Supabase Auth user. `id` must equal `auth.users.id`.
/// The cross-schema FK is applied in the `init_playmates` migration
/// (not expressible in Prisma). Do not drop it to support plain Postgres.
model Profile {
  id          String   @id @db.Uuid
  displayName String?  @map("display_name")
  email       String?  @unique
  avatarUrl   String?  @map("avatar_url")
  bio         String?
  role        Role     @default(ADMIN)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sessions         Session[]
  oauthConnections OauthConnection[]

  @@index([email])
  @@map("profiles")
}
