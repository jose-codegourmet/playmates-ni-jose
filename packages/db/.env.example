# Prisma CLI reads these from packages/db/.env
# Must be Supabase Postgres (hosted or `supabase start`). Profile.id FKs to auth.users.
# For serverless/runtime, prefer the pooled connection (port 6543) for DATABASE_URL.
# TODO: replace DATABASE_URL with the Supabase pooler URL when available:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
