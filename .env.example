# Root env — convenience/reference copy. Read by Turbo via globalEnv.
# Per-app runtime values live in apps/*/.env.local; Prisma CLI reads packages/db/.env.
# Copy to .env and fill in your own values: cp .env.example .env

# Supabase (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Prisma / Postgres
# For serverless/runtime, prefer the pooled connection (port 6543) for DATABASE_URL:
# DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL always stays on the direct connection (port 5432) — migrations need it.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
