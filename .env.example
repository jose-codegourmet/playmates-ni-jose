# Root env — convenience/reference copy. Read by Turbo via globalEnv.
# Per-app runtime values live in apps/*/.env.local; Prisma CLI reads packages/db/.env.
# Copy to .env and fill in your own values: cp .env.example .env

# Supabase (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Admin only. When true, middleware skips Supabase session and injects a fake admin.
MOCK_AUTH=true

# Public origin for sitemap/robots in apps/web.
NEXT_PUBLIC_SITE_URL=http://localhost:9000

# Prisma / Postgres
# DATABASE_URL: pooled connection (port 6543) for serverless/runtime.
# DIRECT_URL: session-mode pooler (port 5432) or the direct db.<ref>.supabase.co host
# when IPv4 is available. Migrations need a non-transaction-pooler connection.
# DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres"
